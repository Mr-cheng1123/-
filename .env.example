# 默认只使用纸面账户。public 也只改变行情来源，不会变成实盘。
TRADING_MODE=paper
DATA_SOURCE=public
PORT=8787
# CONFIG_PATH=config.json
# DATA_DIR=data

# 应用自动读取系统 HTTPS_PROXY / HTTP_PROXY。以下项仅作用于本项目。
# EXCHANGE_PROXY_URL=http://127.0.0.1:7890
# BINANCE_PROXY_URL=http://127.0.0.1:7891
# BYBIT_PROXY_URL=http://127.0.0.1:7891
# GATE_PROXY_URL=direct
# EXCHANGE_HTTP_TIMEOUT_MS=8000
# EXCHANGE_HTTP_RETRIES=1
# HTTP 超时是单次调用的总预算，包含响应正文和所有 GET 重试；不是每次重试重新等待。
# GET 短暂网络故障最多重试一次；下单和撤单请求不会自动重发。

# TRADING_MODE=live 可进入实盘准备页面；未解锁时自动轮询只获取公开行情，不发送交易订单。
# 在账户配置页主动发起的只读检查可读取余额与持仓，不改变交易许可。
# 实盘账户凭据在本机填写，也可在实盘准备页面保存并执行只读连接检查。
# Bitget 自动识别账户：unified 使用 UTA v3，hybrid 使用 Classic v2；未知或升级中不猜测路由。
# 仅在完成交易所测试环境联调、独立账户对账之后自行解锁执行。
# TRADING_MODE=live
# DATA_SOURCE=public
# ALLOW_LIVE_TRADING=true
# LIVE_TRADING_ACK=I_UNDERSTAND_THE_RISKS
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# GATE_API_KEY=
# GATE_API_SECRET=
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_PASSPHRASE=

# CoinGlass 官方资金费率统计（数据 API，Hobbyist 及以上；缺失时显示未配置）
# 只在服务器设置，勿把真实密钥写进前端配置或分享包。
# COINGLASS_API_KEY=
# 可选 HTTP/HTTPS 代理；未设置时继承 EXCHANGE_PROXY_URL / HTTPS_PROXY / HTTP_PROXY。
# COINGLASS_PROXY_URL=http://127.0.0.1:17893
# COINGLASS_PROXY_URL=direct
FUNDING_WS_MAX_SYMBOLS=24
